# 1. Берем официальный базовый образ Python (легкую Linux-версию)
FROM python:3.10-slim

# 2. Устанавливаем системную папку внутри контейнера, где будет лежать код
WORKDIR /app

# 3. Скопируем список зависимостей (библиотек) внутрь контейнера
COPY requirements.txt .

# 4. Запускаем установку всех библиотек Python
RUN pip install --no-cache-dir -r requirements.txt

# 5. Скопируем абсолютно весь оставшийся код из папки server внутрь /app в контейнере
COPY . .

# 6. Указываем Докеру, что наше приложение будет слушать порт 8000
EXPOSE 8000

# 7. Команда, которая автоматически запустит FastAPI при старте контейнера
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
